generator kysely {
  provider = "prisma-kysely"
}

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

generator zod {
  provider             = "zod-prisma-types"
  createInputTypes     = false
  writeBarrelFiles     = false
  useMultipleFiles     = true
  useDefaultValidators = false
}

datasource db {
  provider  = "postgresql"
  url       = env("NEXT_PRIVATE_DATABASE_URL")
  directUrl = env("NEXT_PRIVATE_DIRECT_DATABASE_URL")
}

// Todo: (RR7) Remove after RR7 migration.
enum IdentityProvider {
  DOCUMENSO
  GOOGLE
  OIDC
}

enum Role {
  ADMIN
  USER
}

model User {
  id               Int              @id @default(autoincrement())
  name             String?
  customerId       String?          @unique
  email            String           @unique
  emailVerified    DateTime?
  password         String? // Todo: (RR7) Remove after RR7 migration.
  source           String?
  signature        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  lastSignedIn     DateTime         @default(now())
  roles            Role[]           @default([USER])
  identityProvider IdentityProvider @default(DOCUMENSO) // Todo: (RR7) Remove after RR7 migration.
  avatarImageId    String?
  disabled         Boolean          @default(false)

  // When an admin creates a user directly, this is true so the user is forced
  // to set a password on first login.
  mustChangePassword Boolean @default(false)

  pushTokens         PushDeviceToken[]
  pushNotifPrefs     PushNotificationPreference?

  accounts             Account[]
  sessions             Session[]
  documents            Document[]
  folders              Folder[]
  subscriptions        Subscription[]
  passwordResetTokens  PasswordResetToken[]
  ownedTeams           Team[]
  ownedPendingTeams    TeamPending[]
  teamMembers          TeamMember[]
  twoFactorSecret      String?
  twoFactorEnabled     Boolean              @default(false)
  twoFactorBackupCodes String?
  url                  String?              @unique

  profile            UserProfile?
  verificationTokens VerificationToken[]
  apiTokens          ApiToken[]
  templates          Template[]
  securityAuditLogs  UserSecurityAuditLog[]
  webhooks           Webhook[]
  siteSettings       SiteSettings[]
  passkeys           Passkey[]
  avatarImage        AvatarImage?           @relation(fields: [avatarImageId], references: [id], onDelete: SetNull)

  // DMS relations
  dmsLocations          DmsLocation[]
  dmsDocuments          DmsDocument[]
  dmsCheckedOutDocs     DmsDocument[] @relation("DmsCheckedOutBy")
  dmsVersions           DmsVersion[]
  dmsRetrievalRequests  DmsRetrievalRequest[] @relation("DmsRetrievalRequester")
  dmsRetrievalApprovals DmsRetrievalRequest[] @relation("DmsRetrievalApprover")
  dmsFilingRules        DmsFilingRule[]
  dmsAuditLogs          DmsAuditLog[]
  dmsComments           DmsComment[]
  dmsWorkflowsInitiated DmsWorkflow[] @relation("DmsWorkflowInitiator")
  dmsWorkflowSteps      DmsWorkflowStep[] @relation("DmsWorkflowAssignee")
  dmsPermissions        DmsPermission[]
  dmsPermissionsGranted DmsPermission[] @relation("DmsPermissionGranter")
  dmsDocumentLinks      DmsDocumentLink[]
  dmsFavorites          DmsFavorite[]
  dmsShareLinks         DmsShareLink[]
  dmsAutoFilingSettings DmsAutoFilingSettings?
  organizationMemberships OrganizationMember[]
  dmsOrgPermissionsGranted DmsOrgPermission[] @relation("DmsOrgPermissionGranter")
  dmsRecycleBinItems    DmsRecycleBinItem[] @relation("DmsRecycleBinDeleter")
  dmsSavedSearches      DmsSavedSearch[]
  dmsAiConversations    DmsAiConversation[]
  dmsAiUsage            DmsAiUsage[]
  createdWorkflows      Workflow[]            @relation("UserCreatedWorkflows")

  @@index([email])
}

model UserProfile {
  id      String  @id @default(cuid())
  enabled Boolean @default(false)
  userId  Int     @unique
  bio     String?

  User User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamProfile {
  id      String  @id @default(cuid())
  enabled Boolean @default(false)
  teamId  Int     @unique
  bio     String?

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

enum UserSecurityAuditLogType {
  ACCOUNT_PROFILE_UPDATE
  ACCOUNT_SSO_LINK
  AUTH_2FA_DISABLE
  AUTH_2FA_ENABLE
  PASSKEY_CREATED
  PASSKEY_DELETED
  PASSKEY_UPDATED
  PASSWORD_RESET
  PASSWORD_UPDATE
  SIGN_OUT
  SIGN_IN
  SIGN_IN_FAIL
  SIGN_IN_2FA_FAIL
  SIGN_IN_PASSKEY_FAIL
}

model UserSecurityAuditLog {
  id        Int                      @id @default(autoincrement())
  userId    Int
  createdAt DateTime                 @default(now())
  type      UserSecurityAuditLogType
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiry    DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Passkey {
  id                   String    @id @default(cuid())
  userId               Int
  name                 String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())
  lastUsedAt           DateTime?
  credentialId         Bytes
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnonymousVerificationToken {
  id        String   @id @unique @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id          Int      @id @default(autoincrement())
  secondaryId String   @unique @default(cuid())
  identifier  String
  token       String   @unique
  completed   Boolean  @default(false)
  expires     DateTime
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WebhookTriggerEvents {
  DOCUMENT_CREATED
  DOCUMENT_SENT
  DOCUMENT_OPENED
  DOCUMENT_SIGNED
  DOCUMENT_COMPLETED
  DOCUMENT_REJECTED
  DOCUMENT_CANCELLED
}

model Webhook {
  id            String                 @id @default(cuid())
  webhookUrl    String
  eventTriggers WebhookTriggerEvents[]
  secret        String?
  enabled       Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
  userId        Int
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        Int?
  team          Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  webhookCalls  WebhookCall[]
}

enum WebhookCallStatus {
  SUCCESS
  FAILED
}

model WebhookCall {
  id              String               @id @default(cuid())
  status          WebhookCallStatus
  url             String
  event           WebhookTriggerEvents
  requestBody     Json
  responseCode    Int
  responseHeaders Json?
  responseBody    Json?
  createdAt       DateTime             @default(now())
  webhookId       String
  webhook         Webhook              @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

enum ApiTokenAlgorithm {
  SHA512
}

model ApiToken {
  id        Int               @id @default(autoincrement())
  name      String
  token     String            @unique
  algorithm ApiTokenAlgorithm @default(SHA512)
  expires   DateTime?
  createdAt DateTime          @default(now())
  userId    Int?
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    Int?
  team      Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  INACTIVE
}

model Subscription {
  id                Int                @id @default(autoincrement())
  status            SubscriptionStatus @default(INACTIVE)
  planId            String             @unique
  priceId           String
  periodEnd         DateTime?
  userId            Int?
  teamId            Int?               @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cancelAtPeriodEnd Boolean            @default(false)

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  // Some providers return created_at so we need to make it optional
  created_at        Int?
  // Stops next-auth from crashing when dealing with AzureAD
  ext_expires_in    Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  password          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       Int

  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DocumentStatus {
  DRAFT
  PENDING
  COMPLETED
  REJECTED
}

enum DocumentSource {
  DOCUMENT
  TEMPLATE
  TEMPLATE_DIRECT_LINK
}

enum DocumentVisibility {
  EVERYONE
  MANAGER_AND_ABOVE
  ADMIN
}

enum FolderType {
  DOCUMENT
  TEMPLATE
}

model Folder {
  id         String             @id @default(cuid())
  name       String
  userId     Int
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId     Int?
  team       Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pinned     Boolean            @default(false)
  parentId   String?
  parent     Folder?            @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  documents  Document[]
  templates  Template[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
  subfolders Folder[]           @relation("FolderToFolder")
  visibility DocumentVisibility @default(EVERYONE)
  type       FolderType

  @@index([userId])
  @@index([teamId])
  @@index([parentId])
  @@index([type])
}

/// @zod.import(["import { ZDocumentAuthOptionsSchema } from '@documenso/lib/types/document-auth';", "import { ZDocumentFormValuesSchema } from '@documenso/lib/types/document-form-values';"])
model Document {
  id             Int                 @id @default(autoincrement())
  qrToken        String? /// @zod.string.describe("The token for viewing the document using the QR code on the certificate.")
  signatureHash  String? /// @zod.string.describe("SHA-256 hex digest of the sealed PDF bytes; used by the public /verify page so anyone can confirm the file is unmodified.")
  externalId     String? /// @zod.string.describe("A custom external ID you can use to identify the document.")
  userId         Int /// @zod.number.describe("The ID of the user that created this document.")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  authOptions    Json? /// [DocumentAuthOptions] @zod.custom.use(ZDocumentAuthOptionsSchema)
  formValues     Json? /// [DocumentFormValues] @zod.custom.use(ZDocumentFormValuesSchema)
  visibility     DocumentVisibility  @default(EVERYONE)
  title          String
  status         DocumentStatus      @default(DRAFT)
  recipients     Recipient[]
  fields         Field[]
  shareLinks     DocumentShareLink[]
  documentDataId String
  documentMeta   DocumentMeta?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  completedAt    DateTime?
  deletedAt      DateTime?
  teamId         Int?
  templateId     Int?
  source         DocumentSource

  useLegacyFieldInsertion Boolean @default(false)

  // PDF lock: when set, the password (encrypted at rest with the app's secondary key)
  // is applied to the final PDF on seal, then this field is cleared so the system
  // no longer holds the password.
  pdfPassword String?
  pdfLocked   Boolean @default(false)

  // How many pages at the END of the sealed PDF are the audit certificate.
  // Set at seal time so the client can offer a "Download without audit
  // certificate" option by stripping the last N pages with pdf-lib. 0 for
  // unsealed docs, also 0 for legacy docs sealed before this column existed.
  certificatePageCount Int @default(0)

  documentData DocumentData @relation(fields: [documentDataId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id])
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  auditLogs DocumentAuditLog[]
  folder    Folder?            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  String?

  // DMS auto-filing link
  dmsDocument DmsDocument?

  stampPlacements DocumentStampPlacement[]

  // Signature inbox (email-to-sign queue) link
  inboxItem SignatureInboxItem?

  @@unique([documentDataId])
  @@index([userId])
  @@index([status])
  @@index([folderId])
}

model DocumentAuditLog {
  id         String   @id @default(cuid())
  documentId Int
  createdAt  DateTime @default(now())
  type       String
  data       Json

  // Details of the person who performed the action which caused the audit log.
  name      String?
  email     String?
  userId    Int?
  userAgent String?
  ipAddress String?

  Document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum DocumentDataType {
  S3_PATH
  BYTES
  BYTES_64
}

enum DocumentSigningOrder {
  PARALLEL
  SEQUENTIAL
}

model DocumentData {
  id          String           @id @default(cuid())
  type        DocumentDataType
  data        String
  initialData String
  document    Document?
  template    Template?
}

enum DocumentDistributionMethod {
  EMAIL
  NONE
}

/// @zod.import(["import { ZDocumentEmailSettingsSchema } from '@documenso/lib/types/document-email';"])
model DocumentMeta {
  id                     String               @id @default(cuid())
  subject                String?
  message                String?
  timezone               String?              @default("Etc/UTC") @db.Text
  password               String?
  dateFormat             String?              @default("yyyy-MM-dd hh:mm a") @db.Text
  documentId             Int                  @unique
  document               Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  redirectUrl            String?
  signingOrder           DocumentSigningOrder @default(PARALLEL)
  allowDictateNextSigner Boolean              @default(false)

  typedSignatureEnabled  Boolean @default(true)
  uploadSignatureEnabled Boolean @default(true)
  drawSignatureEnabled   Boolean @default(true)

  language           String                     @default("en")
  distributionMethod DocumentDistributionMethod @default(EMAIL)
  emailSettings      Json? /// [DocumentEmailSettings] @zod.custom.use(ZDocumentEmailSettingsSchema)
}

enum ReadStatus {
  NOT_OPENED
  OPENED
}

enum SendStatus {
  NOT_SENT
  SENT
}

enum SigningStatus {
  NOT_SIGNED
  SIGNED
  REJECTED
}

enum RecipientRole {
  CC
  SIGNER
  VIEWER
  APPROVER
  ASSISTANT
}

/// @zod.import(["import { ZRecipientAuthOptionsSchema } from '@documenso/lib/types/document-auth';"])
model Recipient {
  id                   Int                   @id @default(autoincrement())
  documentId           Int?
  templateId           Int?
  email                String                @db.VarChar(255)
  name                 String                @default("") @db.VarChar(255)
  token                String
  documentDeletedAt    DateTime?
  expired              DateTime?
  signedAt             DateTime?
  authOptions          Json? /// [RecipientAuthOptions] @zod.custom.use(ZRecipientAuthOptionsSchema)
  signingOrder         Int? /// @zod.number.describe("The order in which the recipient should sign the document. Only works if the document is set to sequential signing.")
  rejectionReason      String?
  role                 RecipientRole         @default(SIGNER)
  readStatus           ReadStatus            @default(NOT_OPENED)
  signingStatus        SigningStatus         @default(NOT_SIGNED)
  sendStatus           SendStatus            @default(NOT_SENT)
  document             Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  template             Template?             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields               Field[]
  signatures           Signature[]
  fieldSignedPositions FieldSignedPosition[]

  // Sign reminder tracking
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  @@unique([documentId, email])
  @@unique([templateId, email])
  @@index([documentId])
  @@index([templateId])
  @@index([token])
}

enum FieldType {
  SIGNATURE
  FREE_SIGNATURE
  INITIALS
  NAME
  EMAIL
  DATE
  TEXT
  NUMBER
  RADIO
  CHECKBOX
  DROPDOWN
}

/// @zod.import(["import { ZFieldMetaNotOptionalSchema } from '@documenso/lib/types/field-meta';"])
model Field {
  id                  Int                  @id @default(autoincrement())
  secondaryId         String               @unique @default(cuid())
  documentId          Int?
  templateId          Int?
  recipientId         Int
  type                FieldType
  page                Int /// @zod.number.describe("The page number of the field on the document. Starts from 1.")
  positionX           Decimal              @default(0)
  positionY           Decimal              @default(0)
  width               Decimal              @default(-1)
  height              Decimal              @default(-1)
  customText          String
  inserted            Boolean
  document            Document?            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  template            Template?            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipient           Recipient            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  signature           Signature?
  fieldSignedPosition FieldSignedPosition?
  fieldMeta           Json? /// [FieldMeta] @zod.custom.use(ZFieldMetaNotOptionalSchema)

  @@index([documentId])
  @@index([templateId])
  @@index([recipientId])
}

model FieldSignedPosition {
  id                   Int      @id @default(autoincrement())
  fieldSignedPositionX Decimal?
  fieldSignedPositionY Decimal?

  fieldId     Int @unique
  recipientId Int

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  field     Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@index([recipientId])
}

model Signature {
  id                     Int      @id @default(autoincrement())
  created                DateTime @default(now())
  recipientId            Int
  fieldId                Int      @unique
  signatureImageAsBase64 String?
  typedSignature         String?
  signaturePositionX     Decimal?
  signaturePositionY     Decimal?

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  field     Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model DocumentShareLink {
  id         Int      @id @default(autoincrement())
  email      String
  slug       String   @unique
  documentId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, email])
}

enum TeamMemberRole {
  ADMIN
  MANAGER
  MEMBER
}

enum TeamMemberInviteStatus {
  ACCEPTED
  PENDING
  DECLINED
}

model TeamGlobalSettings {
  teamId                    Int                @unique
  documentVisibility        DocumentVisibility @default(EVERYONE)
  documentLanguage          String             @default("en")
  includeSenderDetails      Boolean            @default(true)
  includeSigningCertificate Boolean            @default(true)

  typedSignatureEnabled  Boolean @default(true)
  uploadSignatureEnabled Boolean @default(true)
  drawSignatureEnabled   Boolean @default(true)

  brandingEnabled        Boolean @default(false)
  brandingLogo           String  @default("")
  brandingUrl            String  @default("")
  brandingCompanyDetails String  @default("")
  brandingHidePoweredBy  Boolean @default(false)

  allowEmbeddedAuthoring Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Team {
  id            Int      @id @default(autoincrement())
  name          String
  url           String   @unique
  createdAt     DateTime @default(now())
  avatarImageId String?
  customerId    String?  @unique
  ownerUserId   Int

  members              TeamMember[]
  invites              TeamMemberInvite[]
  teamEmail            TeamEmail?
  emailVerification    TeamEmailVerification?
  transferVerification TeamTransferVerification?
  teamGlobalSettings   TeamGlobalSettings?
  avatarImage          AvatarImage?              @relation(fields: [avatarImageId], references: [id], onDelete: SetNull)

  profile      TeamProfile?
  owner        User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  subscription Subscription?

  documents Document[]
  templates Template[]
  folders   Folder[]
  apiTokens ApiToken[]
  webhooks  Webhook[]

  // Organization
  organizationId Int?
  organization   Organization? @relation("OrgTeams", fields: [organizationId], references: [id])

  // DMS relations
  dmsLocations       DmsLocation[]
  dmsDocumentTypes   DmsDocumentType[]
  dmsClassifications DmsClassification[]
  dmsTags            DmsTag[]
  dmsDocuments            DmsDocument[]
  dmsFilingRules          DmsFilingRule[]
  dmsComplianceTemplates  DmsComplianceTemplate[]
  dmsAutoFilingSettings   DmsAutoFilingSettings[]
}

model TeamPending {
  id          Int      @id @default(autoincrement())
  name        String
  url         String   @unique
  createdAt   DateTime @default(now())
  customerId  String   @unique
  ownerUserId Int

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        Int            @id @default(autoincrement())
  teamId    Int
  createdAt DateTime       @default(now())
  role      TeamMemberRole
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model TeamEmail {
  teamId    Int      @id @unique
  createdAt DateTime @default(now())
  name      String
  email     String   @unique
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model TeamEmailVerification {
  teamId    Int      @id @unique
  name      String
  email     String
  token     String   @unique
  completed Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model TeamTransferVerification {
  teamId              Int      @id @unique
  userId              Int
  name                String
  email               String
  token               String   @unique
  completed           Boolean  @default(false)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  clearPaymentMethods Boolean  @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model TeamMemberInvite {
  id        Int                    @id @default(autoincrement())
  teamId    Int
  createdAt DateTime               @default(now())
  email     String
  status    TeamMemberInviteStatus @default(PENDING)
  role      TeamMemberRole
  token     String                 @unique
  team      Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

enum TemplateType {
  PUBLIC
  PRIVATE
}

/// @zod.import(["import { ZDocumentEmailSettingsSchema } from '@documenso/lib/types/document-email';"])
model TemplateMeta {
  id                     String                     @id @default(cuid())
  subject                String?
  message                String?
  timezone               String?                    @default("Etc/UTC") @db.Text
  password               String?
  dateFormat             String?                    @default("yyyy-MM-dd hh:mm a") @db.Text
  signingOrder           DocumentSigningOrder?      @default(PARALLEL)
  allowDictateNextSigner Boolean                    @default(false)
  distributionMethod     DocumentDistributionMethod @default(EMAIL)

  typedSignatureEnabled  Boolean @default(true)
  uploadSignatureEnabled Boolean @default(true)
  drawSignatureEnabled   Boolean @default(true)

  templateId    Int      @unique
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  redirectUrl   String?
  language      String   @default("en")
  emailSettings Json? /// [DocumentEmailSettings] @zod.custom.use(ZDocumentEmailSettingsSchema)
}

/// @zod.import(["import { ZDocumentAuthOptionsSchema } from '@documenso/lib/types/document-auth';"])
model Template {
  id                     Int                @id @default(autoincrement())
  externalId             String?
  type                   TemplateType       @default(PRIVATE)
  title                  String
  userId                 Int
  teamId                 Int?
  visibility             DocumentVisibility @default(EVERYONE)
  authOptions            Json? /// [DocumentAuthOptions] @zod.custom.use(ZDocumentAuthOptionsSchema)
  templateMeta           TemplateMeta?
  templateDocumentDataId String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt
  publicTitle            String             @default("")
  publicDescription      String             @default("")

  useLegacyFieldInsertion Boolean @default(false)

  team                 Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateDocumentData DocumentData        @relation(fields: [templateDocumentDataId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients           Recipient[]
  fields               Field[]
  directLink           TemplateDirectLink?
  documents            Document[]
  folder               Folder?             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId             String?

  @@unique([templateDocumentDataId])
}

model TemplateDirectLink {
  id         String   @id @unique @default(cuid())
  templateId Int      @unique
  token      String   @unique
  createdAt  DateTime @default(now())
  enabled    Boolean

  directTemplateRecipientId Int

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id                   String   @id
  enabled              Boolean  @default(false)
  data                 Json
  lastModifiedByUserId Int?
  lastModifiedAt       DateTime @default(now())
  lastModifiedByUser   User?    @relation(fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id         String              @id @default(cuid())
  status     BackgroundJobStatus @default(PENDING)
  payload    Json?
  retried    Int                 @default(0)
  maxRetries Int                 @default(3)

  // Taken from the job definition
  jobId   String
  name    String
  version String

  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  lastRetriedAt DateTime?

  tasks BackgroundJobTask[]
}

enum BackgroundJobTaskStatus {
  PENDING
  COMPLETED
  FAILED
}

model BackgroundJobTask {
  id     String                  @id
  name   String
  status BackgroundJobTaskStatus @default(PENDING)

  result     Json?
  retried    Int   @default(0)
  maxRetries Int   @default(3)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  jobId         String
  backgroundJob BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AvatarImage {
  id    String @id @default(cuid())
  bytes String

  team Team[]
  user User[]
}

// ═══════════════════════════════════════════════════════════
// DOCUMENT MANAGEMENT SYSTEM (DMS) MODULE
// ═══════════════════════════════════════════════════════════

enum DmsDocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
  DESTROYED
}

enum DmsDocumentFormat {
  DIGITAL
  PHYSICAL
  BOTH
}

enum DmsDisposalStatus {
  NOT_DUE
  DUE_FOR_REVIEW
  APPROVED_FOR_DISPOSAL
  DISPOSED
  RETAINED
}

enum DmsConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DmsRetrievalStatus {
  PENDING
  APPROVED
  REJECTED
  RETRIEVED
  RETURNED
  OVERDUE
}

// ── Filing Structure ──

model DmsLocation {
  id          String   @id @default(cuid())
  name        String
  address     String?
  description String?

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsLocations", fields: [organizationId], references: [id])

  cabinets    DmsCabinet[]
  permissions DmsPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsCabinet {
  id          String @id @default(cuid())
  name        String
  description String?

  locationId String
  location   DmsLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  shelves DmsShelf[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsShelf {
  id    String  @id @default(cuid())
  name  String
  label String?

  cabinetId String
  cabinet   DmsCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  bins DmsBin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsBin {
  id      String  @id @default(cuid())
  name    String
  barcode String? @unique
  label   String?

  shelfId String
  shelf   DmsShelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  documents DmsDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Document Types & Classification ──

model DmsDocumentType {
  id             String @id @default(cuid())
  name           String
  description    String?
  /// [DmsMetadataSchema]
  metadataSchema Json?

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsDocTypes", fields: [organizationId], references: [id])

  documents DmsDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsClassification {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String?

  parentId String?
  parent   DmsClassification?  @relation("ClassificationTree", fields: [parentId], references: [id])
  children DmsClassification[] @relation("ClassificationTree")

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsClassifications", fields: [organizationId], references: [id])

  documents   DmsDocument[]
  permissions DmsPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsTag {
  id   String @id @default(cuid())
  name String

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsTags", fields: [organizationId], references: [id])

  documents DmsDocumentTag[]

  createdAt DateTime @default(now())

  @@unique([name, teamId])
}

// ── Core Document ──

model DmsDocument {
  id              String              @id @default(cuid())
  title           String
  description     String?
  referenceNumber String?             @unique
  fileUrl         String
  fileName        String
  fileType        String
  fileSize        Int
  ocrText         String?
  ocrProcessed    Boolean             @default(false)
  status          DmsDocumentStatus   @default(ACTIVE)
  format          DmsDocumentFormat   @default(DIGITAL)
  confidentiality DmsConfidentiality  @default(INTERNAL)
  disposalStatus  DmsDisposalStatus   @default(NOT_DUE)
  disposalDate    DateTime?
  disposalApprovedById Int?
  disposalNotes   String?
  physicalLocation String?
  labelPrinted    Boolean             @default(false)
  /// [DmsDocumentMetadata]
  metadata        Json?
  retentionDate   DateTime?
  expiryDate      DateTime?

  // Filing location
  binId String?
  bin   DmsBin? @relation(fields: [binId], references: [id])

  // Classification
  documentTypeId   String?
  documentType     DmsDocumentType? @relation(fields: [documentTypeId], references: [id])
  classificationId String?
  classification   DmsClassification? @relation(fields: [classificationId], references: [id])

  // Link to signed document (auto-filing)
  signedDocumentId Int?      @unique
  signedDocument   Document? @relation(fields: [signedDocumentId], references: [id])

  // Check-in/Check-out
  checkedOut     Boolean   @default(false)
  checkedOutById Int?
  checkedOutBy   User?     @relation("DmsCheckedOutBy", fields: [checkedOutById], references: [id])
  checkedOutAt   DateTime?
  checkoutNotes  String?

  // Ownership
  uploadedById Int
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsDocuments", fields: [organizationId], references: [id])

  // Relations
  tags             DmsDocumentTag[]
  recycleBinItem   DmsRecycleBinItem?
  versions         DmsVersion[]
  retrievalRequests DmsRetrievalRequest[]
  auditLogs        DmsAuditLog[]
  comments         DmsComment[]
  workflows        DmsWorkflow[]
  permissions      DmsPermission[]
  linksAsSource    DmsDocumentLink[] @relation("DmsLinkSource")
  linksAsTarget    DmsDocumentLink[] @relation("DmsLinkTarget")
  favorites        DmsFavorite[]
  shareLinks       DmsShareLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsDocumentTag {
  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        DmsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

// ── Versioning ──

model DmsVersion {
  id      String @id @default(cuid())
  version Int
  fileUrl String
  fileSize Int
  notes   String?

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  uploadedById Int
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// ── Retrieval Requests ──

model DmsRetrievalRequest {
  id     String              @id @default(cuid())
  status DmsRetrievalStatus  @default(PENDING)
  notes  String?
  reason String?

  dueDate    DateTime?
  returnDate DateTime?

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  requestedById Int
  requestedBy   User @relation("DmsRetrievalRequester", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("DmsRetrievalApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Filing Rules (Auto-filing) ──

model DmsFilingRule {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  /// [DmsFilingCondition]
  condition Json
  // Destination
  binId          String?
  documentTypeId String?
  classificationId String?

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsFilingRules", fields: [organizationId], references: [id])

  createdBy Int
  creator   User @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Audit Log ──

model DmsAuditLog {
  id     String @id @default(cuid())
  action String
  details String?
  ipAddress String?

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ── Comments ──

model DmsComment {
  id   String @id @default(cuid())
  text String

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Approval Workflows ──

enum DmsWorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum DmsWorkflowStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model DmsWorkflow {
  id          String            @id @default(cuid())
  name        String
  description String?
  status      DmsWorkflowStatus @default(PENDING)

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  initiatedById Int
  initiatedBy   User @relation("DmsWorkflowInitiator", fields: [initiatedById], references: [id])

  currentStep Int @default(1)

  steps DmsWorkflowStep[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DmsWorkflowStep {
  id       String                @id @default(cuid())
  step     Int
  action   String                @default("APPROVE")
  status   DmsWorkflowStepStatus @default(PENDING)
  notes    String?
  dueDate  DateTime?

  workflowId String
  workflow   DmsWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  assignedToId Int
  assignedTo   User @relation("DmsWorkflowAssignee", fields: [assignedToId], references: [id])

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Access Control ──

enum DmsPermissionLevel {
  VIEW
  DOWNLOAD
  EDIT
  DELETE
  ADMIN
}

model DmsPermission {
  id    String             @id @default(cuid())
  level DmsPermissionLevel

  // Can be scoped to location, document, or classification
  locationId       String?
  location         DmsLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  documentId       String?
  document         DmsDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  classificationId String?
  classification   DmsClassification? @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  grantedById Int
  grantedBy   User @relation("DmsPermissionGranter", fields: [grantedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, locationId, level])
  @@unique([userId, documentId, level])
}

// ── Document Links ──

model DmsDocumentLink {
  id       String @id @default(cuid())
  linkType String @default("RELATED")

  sourceDocumentId String
  sourceDocument   DmsDocument @relation("DmsLinkSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  targetDocumentId String
  targetDocument   DmsDocument @relation("DmsLinkTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([sourceDocumentId, targetDocumentId])
}

// ── Favorites ──

model DmsFavorite {
  id String @id @default(cuid())

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, documentId])
}

// ── Secure Share Links ──

model DmsShareLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  password  String?
  expiresAt DateTime?
  maxViews  Int?
  viewCount Int      @default(0)
  active    Boolean  @default(true)

  documentId String
  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// ── Compliance Templates ──

model DmsComplianceTemplate {
  id              String @id @default(cuid())
  name            String
  description     String?
  industry        String
  retentionYears  Int
  disposalAction  String @default("ARCHIVE")
  legalBasis      String?

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation("OrgDmsCompliance", fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

// ── Auto-Filing Settings ──

model DmsAutoFilingSettings {
  id      String  @id @default(cuid())
  enabled Boolean @default(true)

  // Where to file signed documents
  binId            String?
  documentTypeId   String?
  classificationId String?
  confidentiality  DmsConfidentiality @default(INTERNAL)
  autoOcr          Boolean            @default(true)

  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// ORGANIZATION (MULTI-TENANCY)
// ═══════════════════════════════════════════════════════════

enum OrganizationRole {
  ORG_ADMIN
  DMS_ADMIN
  TEAM_ADMIN
  MANAGER
  MEMBER
}

enum DmsPermissionAction {
  DMS_VIEW
  DMS_UPLOAD
  DMS_DOWNLOAD
  DMS_EDIT
  DMS_DELETE
  DMS_MANAGE_FILING
  DMS_MANAGE_TYPES
  DMS_APPROVE_WORKFLOWS
  DMS_APPROVE_RETRIEVALS
  DMS_MANAGE_RETENTION
  DMS_EXPORT
  DMS_VIEW_AUDIT_TRAIL
}

model Organization {
  id     Int    @id @default(autoincrement())
  name   String
  slug   String @unique
  domain String? @unique
  logoUrl String?

  // Branding
  brandingLogo              String?  // URL or base64
  brandingPrimaryColor      String?  // hex e.g. #7c5cfc
  brandingAccentColor       String?  // hex e.g. #f59e0b
  brandingSidebarBg         String?  // hex e.g. #0d0d10
  brandingSidebarTextColor  String?  // hex e.g. #f4f2ff
  brandingNavActiveColor   String?  // hex for active nav item
  brandingButtonColor       String?  // hex e.g. #7c5cfc
  brandingButtonHoverColor  String?  // hex e.g. #6a4af0
  brandingButtonTextColor   String?  // hex e.g. #ffffff

  // OCR / BMS ML Settings
  ocrApiUrl            String?  // e.g. http://bms-ml:8080/api/v1
  ocrApiKey            String?  // API key or JWT token
  ocrApiUsername       String?  // For JWT auth: username
  ocrApiPassword       String?  // For JWT auth: password
  ocrDefaultTemplateId Int?     // Default extraction template ID
  ocrAutoProcess       Boolean  @default(false) // Auto-OCR on upload
  ocrDefaultEngine     String?  // auto, doctr, easyocr, tesseract, pymupdf

  // Stripe billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripeSeatPriceId    String?
  stripeDmsPriceId     String?
  seatCount            Int     @default(0)
  billingStatus        String  @default("inactive") // inactive, active, past_due

  defaultConfidentiality DmsConfidentiality @default(INTERNAL)

  // Security: enforce single concurrent session per user (license/security)
  enforceSingleSession Boolean @default(false)

  // Restrict membership to specific email domains (e.g. ["acme.com"]).
  // Empty array = no restriction. Lowercase, no leading '@'.
  allowedEmailDomains String[] @default([])

  // Sign reminders — when enabled, periodically email recipients who haven't
  // signed yet after `signReminderDays` days, up to `signReminderMaxCount` times.
  signReminderEnabled  Boolean @default(false)
  signReminderDays     Int     @default(3)
  signReminderMaxCount Int     @default(3)

  // Per-org OIDC / SSO configuration. When `oidcEnabled` is true and the
  // signin page is accessed with `?org=<slug>`, the OIDC initiate flow uses
  // these credentials instead of the global env-based config. Office 365
  // and Google Workspace both speak OIDC so this works for any provider with
  // a valid well-known discovery URL.
  oidcEnabled         Boolean @default(false)
  oidcClientId        String?
  oidcClientSecret    String?
  oidcWellKnownUrl    String?
  oidcProviderLabel   String? // display name on the SSO button (e.g. "Sign in with Acme SSO")

  // When true, users matching the org's allowedEmailDomains cannot self-signup
  // via the public signup page; they must be invited or use SSO.
  disableSelfSignup Boolean @default(false)

  // Email-to-sign: when enabled, the org has a unique inbox alias that
  // accepts inbound emails with PDF attachments and creates DRAFT documents.
  emailToSignEnabled Boolean @default(false)

  // Per-org signature-inbox (receive) config. The inbox is polled from WorkHub
  // using the org's own WorkHub BulkSender credential (HTTP Basic) — the same
  // auth model as sending — so each org reads its own mailbox. All fields are
  // optional; an org configures these in Org Settings.
  inboxEmail       String? /// Receiving address shown to users, e.g. fepro@inbox.your-domain.
  workhubApiKey    String? /// WorkHub API key (x-api-key) with email.read — reads the inbox.
  workhubUsername  String? /// WorkHub BulkSender credential username (optional Basic fallback).
  workhubPassword  String? /// WorkHub BulkSender credential password (optional Basic fallback).
  workhubMailboxId String? /// Optional mailbox override (?mailboxId=).
  workhubApiBase   String? /// Optional per-org WorkHub API base override.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            OrganizationMember[]
  teams              Team[]               @relation("OrgTeams")
  dmsLocations       DmsLocation[]        @relation("OrgDmsLocations")
  dmsDocumentTypes   DmsDocumentType[]    @relation("OrgDmsDocTypes")
  dmsClassifications DmsClassification[]  @relation("OrgDmsClassifications")
  dmsTags            DmsTag[]             @relation("OrgDmsTags")
  dmsDocuments       DmsDocument[]        @relation("OrgDmsDocuments")
  dmsFilingRules     DmsFilingRule[]      @relation("OrgDmsFilingRules")
  dmsComplianceTemplates DmsComplianceTemplate[] @relation("OrgDmsCompliance")
  recycleBin         DmsRecycleBinItem[]
  savedSearches      DmsSavedSearch[]
  aiConversations    DmsAiConversation[]
  aiUsage            DmsAiUsage[]
  seatPlans          OrgSeatPlan[]
  stamps             Stamp[]
  workflows          Workflow[]           @relation("OrgWorkflows")
}

enum OrgSeatTier {
  STARTER
  PRO
  ENTERPRISE
}

model OrgSeatPlan {
  id   String      @id @default(cuid())
  tier OrgSeatTier

  // Limits for this seat
  documentsPerMonth Int     @default(20)
  recipientsPerMonth Int    @default(50)
  directTemplates   Int     @default(5)
  dmsEnabled        Boolean @default(false)

  // How many seats purchased at this tier
  quantity  Int @default(1)
  // How many are currently assigned
  assigned  Int @default(0)

  // Stripe
  stripePriceId String?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id   String           @id @default(cuid())
  role OrganizationRole @default(MEMBER)

  // Assigned seat tier
  seatTier OrgSeatTier?
  dmsAddon Boolean      @default(false)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Manager hierarchy (used by approval-chain approver resolution).
  managerId        String?
  manager          OrganizationMember?  @relation("OrgMemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     OrganizationMember[] @relation("OrgMemberManager")
  department       String? /// Free-form department/grouping key (e.g. "Finance").
  isDepartmentHead Boolean              @default(false)

  dmsPermissions DmsOrgPermission[]

  joinedAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([managerId])
  @@index([organizationId, department])
}

model DmsOrgPermission {
  id     String              @id @default(cuid())
  action DmsPermissionAction

  memberId String
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  locationId       String?
  classificationId String?

  grantedById Int
  grantedBy   User @relation("DmsOrgPermissionGranter", fields: [grantedById], references: [id])

  createdAt DateTime @default(now())
}

model DmsRecycleBinItem {
  id String @id @default(cuid())

  documentId String   @unique
  document   DmsDocument @relation(fields: [documentId], references: [id])

  deletedById Int
  deletedBy   User @relation("DmsRecycleBinDeleter", fields: [deletedById], references: [id])

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DmsSavedSearch {
  id       String  @id @default(cuid())
  name     String
  /// [DmsSavedSearchCriteria]
  criteria Json
  isShared Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// DMS AI AGENT
// ═══════════════════════════════════════════════════════════

model DmsAiConversation {
  id    String @id @default(cuid())
  title String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messages DmsAiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DmsAiMessage {
  id   String @id @default(cuid())
  role String // user, assistant, system
  content String @db.Text
  
  // Token usage
  promptTokens    Int @default(0)
  completionTokens Int @default(0)

  conversationId String
  conversation   DmsAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model DmsAiUsage {
  id    String @id @default(cuid())
  month String // YYYY-MM format

  totalQueries      Int @default(0)
  totalPromptTokens Int @default(0)
  totalCompletionTokens Int @default(0)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}


// ─────────────────────────────────────────────────────────────────────────────
// Firebase Cloud Messaging (FCM) push notifications
// ─────────────────────────────────────────────────────────────────────────────

model PushDeviceToken {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The FCM registration token issued to this device by the Firebase SDK.
  token     String   @unique
  // Optional context: "web", "ios", "android"
  platform  String?
  // Optional human-readable identifier (browser name, device model)
  label     String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  @@index([userId])
}

model PushNotificationPreference {
  id     String @id @default(cuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentSentToYou      Boolean @default(true)
  documentSigned         Boolean @default(true)
  documentCompleted      Boolean @default(true)
  documentRejected       Boolean @default(true)
  reminderReceived       Boolean @default(true)
}


// Premium per-user / per-team reusable stamps. Three construction kinds:
// - UPLOADED: user uploaded a PNG/JPG/SVG; we store the asset key in
//   `imageAssetId` and apply it as an image overlay at seal time.
// - DESIGNED: user built it in the in-app canvas editor; we store the
//   Fabric.js layout JSON in `layout`.
// - AI_GENERATED: produced by AI Studio (Claude returns a layout); same
//   shape as DESIGNED but tagged so we can attribute usage / show provenance.
enum StampKind {
  UPLOADED
  DESIGNED
  AI_GENERATED
}

model Stamp {
  id             String    @id @default(cuid())
  organizationId Int /// @zod.number.describe("Owning organization. Stamps are org-scoped — every member of the org can use them.")
  name           String /// @zod.string.describe("Display name shown in the stamp library.")
  kind           StampKind
  imageAssetId   String? /// @zod.string.describe("DocumentData id holding the rasterized PNG bytes.")
  layout         Json? /// Fabric.js JSON layout for DESIGNED / AI_GENERATED stamps.
  placeholders   String[] /// Dynamic tokens like {date} or {signer.name} resolved at apply time.
  previewImage   String? /// DocumentData id for the library thumbnail.
  isPremium      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  placements DocumentStampPlacement[]

  @@index([organizationId])
}

// Where a Stamp is placed on a specific Document. Resolved at seal time and
// drawn onto the PDF via pdf-lib (see embed-stamp-on-pdf.ts). Coordinates use
// PDF user-space points (origin = lower-left), matching pdf-lib conventions.
model DocumentStampPlacement {
  id         String   @id @default(cuid())
  documentId Int
  stampId    String
  pageIndex  Int
  x          Float
  y          Float
  width      Float
  height     Float
  rotation   Float? /// @zod.number.describe("Rotation in degrees (clockwise).")
  opacity    Float? /// @zod.number.min(0).max(1)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stamp    Stamp    @relation(fields: [stampId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([stampId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Generic Workflow Manager (org-scoped)
//
// A Workflow is a JSON-defined automation: a `trigger` (what starts it) plus a
// `definition` (a graph of steps — the "processing stream"). Logic is injected
// declaratively as JSONLogic rules inside the definition (see
// packages/lib/types/workflow.ts) and at the code level via the action registry
// (packages/lib/server-only/workflow/actions). Not to be confused with the
// DMS-specific DmsWorkflow approval chains above.
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowTriggerType {
  EVENT // fired by a system event (eSign / DMS lifecycle)
  MANUAL // run on demand from the UI or API
  SCHEDULE // fired on a cron schedule
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model Workflow {
  id             String              @id @default(cuid())
  organizationId Int
  name           String
  description    String?
  enabled        Boolean             @default(false)

  triggerType  WorkflowTriggerType @default(EVENT)
  triggerEvent String? /// Event key when triggerType=EVENT, e.g. "DOCUMENT_COMPLETED" or "DMS_DOCUMENT_FILED".
  cron         String? /// Standard 5-field cron expression when triggerType=SCHEDULE.
  timezone     String?             @default("UTC")
  nextRunAt    DateTime? /// Next computed fire time for scheduled workflows; null otherwise.

  definition Json /// [WorkflowDefinition] The trigger gate + step graph (JSONLogic-based).
  version    Int  @default(1)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization  @relation("OrgWorkflows", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("UserCreatedWorkflows", fields: [createdById], references: [id], onDelete: SetNull)
  runs         WorkflowRun[]

  @@index([organizationId])
  @@index([triggerType, enabled])
  @@index([triggerEvent])
  @@index([nextRunAt])
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  status     WorkflowRunStatus @default(PENDING)
  trigger    String /// How the run started: the event key, "MANUAL", or "SCHEDULE".
  context    Json /// [WorkflowRunContext] Immutable input payload available to every step.
  variables  Json? /// [WorkflowVariables] Mutable variable bag accumulated by SET_VARIABLE steps.
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime          @default(now())

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowRunStep[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

model WorkflowRunStep {
  id         String                @id @default(cuid())
  runId      String
  stepId     String /// Step id within the workflow definition.
  type       String /// CONDITION | BRANCH | ACTION | DELAY | SET_VARIABLE
  status     WorkflowRunStepStatus @default(PENDING)
  input      Json? /// [WorkflowVariables] Snapshot of the resolved step input.
  output     Json? /// [WorkflowVariables] Result of the step (action response, branch taken, etc.).
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime              @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Approval Chain module (org-scoped)
//
// A higher-level layer over the generic Workflow engine: template-driven approval
// chains with dynamic approver resolution, JSONLogic conditional rules + validation,
// reminders/escalation, and template chaining. Gates documents (e.g. those arriving
// via the email-to-sign inbox) before they are released for signature.
//
// References to users/organizations are stored as plain ids (no FK) to keep the
// module decoupled; integrity *within* the module uses relations + cascade.
// ─────────────────────────────────────────────────────────────────────────────

enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalFlowStatus {
  PENDING
  EMAIL_SENT
  EMAIL_READ
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalDetermination {
  FIXED_USER
  ORG_ROLE
  ROLE_MAPPING
  REPORTING_MANAGER
  DEPARTMENT_HEAD
}

enum ApprovalValidationSeverity {
  CRITICAL
  ERROR
  WARNING
  INFO
}

enum ApprovalOnApproveAction {
  NONE
  MARK_APPROVED
  SEND_FOR_SIGNATURE
}

model ApprovalTemplate {
  id             String  @id @default(cuid())
  organizationId Int
  name           String
  description    String?
  entityType     String  @default("Document") /// What this chain gates, e.g. "Document".
  isActive       Boolean @default(true)
  isDefault      Boolean @default(false) /// Picked when no rule/specific template matches.
  triggerStatus  String? /// Optional entity status that triggers this template.

  onApproveAction ApprovalOnApproveAction @default(MARK_APPROVED)

  // Chaining — deterministic precedence: nextTemplateId > nextRuleSetId > triggerStatus.
  nextTemplateId      String?
  nextRuleSetId       String?
  rejectionTemplateId String?

  config Json? /// Free-form extra config.

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@index([organizationId])
  @@index([organizationId, entityType, isActive])
  @@index([organizationId, entityType, isDefault])
}

model ApprovalStep {
  id         String @id @default(cuid())
  templateId String
  stepNumber Int

  name           String
  determination  ApprovalDetermination @default(FIXED_USER)
  approverRole   OrganizationRole? /// For ORG_ROLE.
  fixedUserId    Int? /// For FIXED_USER.
  roleMappingKey String? /// For ROLE_MAPPING (matches ApprovalRoleMapping.roleKey).
  department     String? /// For DEPARTMENT_HEAD.

  isParallel Boolean @default(false)
  isOptional Boolean @default(false)
  isEnd      Boolean @default(false)

  // Reminder / escalation settings.
  enableReminders          Boolean @default(false)
  firstReminderAfterHours  Int?
  secondReminderAfterHours Int?
  escalationAfterHours     Int?
  reminderIntervalHours    Int?
  escalationRecipients     String? /// Comma-separated emails.

  config Json? /// e.g. approver-chain config for ROLE_MAPPING.

  template    ApprovalTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  validations ApprovalStepValidation[]

  @@index([templateId])
  @@index([templateId, stepNumber])
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  organizationId Int
  templateId     String?
  entityType     String
  entityId       String /// Stringified id of the gated entity (e.g. Document.id).
  status         ApprovalRequestStatus @default(PENDING)
  priority       String?
  amount         Float? /// Optional numeric used by rules/validation.
  currentStep    Int                   @default(1)
  requestedById  Int?
  documentFileId String? /// Optional snapshot/preview reference.
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  template  ApprovalTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  flows     ApprovalFlowRecord[]
  reminders ApprovalReminderHistory[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([entityType, entityId, status])
}

model ApprovalFlowRecord {
  id        String  @id @default(cuid())
  requestId String
  stepOrder Int
  stepName  String?

  approverId    Int?
  approverName  String?
  approverEmail String
  approverRole  String?

  isParallel Boolean            @default(false)
  isOptional Boolean            @default(false)
  status     ApprovalFlowStatus @default(PENDING)

  token      String    @unique /// Secure single-use token for email approve/reject links.
  assignedAt DateTime  @default(now())
  actionedAt DateTime?
  decision   String? /// "Approved" | "Rejected".
  comments   String?

  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  request   ApprovalRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reminders ApprovalReminderHistory[]

  @@index([requestId])
  @@index([requestId, stepOrder])
  @@index([approverEmail])
  @@index([status])
}

model ApprovalRuleSet {
  id             String   @id @default(cuid())
  organizationId Int
  entityType     String
  name           String
  priority       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rules ApprovalRule[]

  @@index([organizationId])
  @@index([organizationId, entityType, isActive])
}

model ApprovalRule {
  id              String   @id @default(cuid())
  ruleSetId       String
  name            String
  conditionConfig Json /// JSONLogic deciding if this rule matches.
  templateId      String? /// Template to use when matched.
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  ruleSet ApprovalRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId])
  @@index([ruleSetId, isActive, priority])
}

model ApprovalRoleMapping {
  id                String   @id @default(cuid())
  organizationId    Int
  roleType          String /// e.g. "Department".
  roleKey           String /// e.g. "Finance".
  approvalLevel     Int      @default(1)
  primaryApproverId Int
  backupApproverId  Int?
  reminderHours     Int?
  expiryHours       Int?
  isParallel        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId, roleType, roleKey, approvalLevel])
}

model ApprovalValidationRule {
  id              String                     @id @default(cuid())
  organizationId  Int
  name            String
  validationType  String /// Conditional | Required | Range | Pattern | CrossField | Custom.
  conditionConfig Json /// JSON config for the check.
  errorMessage    String
  severity        ApprovalValidationSeverity @default(ERROR)
  entityType      String?
  isActive        Boolean                    @default(true)
  description     String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  steps ApprovalStepValidation[]

  @@index([organizationId])
  @@index([organizationId, isActive, validationType])
  @@index([entityType])
}

model ApprovalStepValidation {
  id               String  @id @default(cuid())
  stepId           String
  validationRuleId String
  priority         Int     @default(0)
  isActive         Boolean @default(true)

  step           ApprovalStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  validationRule ApprovalValidationRule @relation(fields: [validationRuleId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([validationRuleId])
  @@index([stepId, priority])
}

model ApprovalReminderHistory {
  id                String    @id @default(cuid())
  requestId         String
  flowRecordId      String
  recipientEmail    String
  reminderType      String /// "First" | "Second" | "Escalation" | "Interval".
  sentAt            DateTime  @default(now())
  respondedAt       DateTime?
  responseAction    String?
  responseTimeHours Float?
  entityType        String?
  entityAmount      Float?

  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  flowRecord ApprovalFlowRecord @relation(fields: [flowRecordId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([flowRecordId])
  @@index([sentAt])
  @@index([recipientEmail])
}

// ─────────────────────────────────────────────────────────────────────────────
// Signature Inbox (email-to-sign queue)
//
// Each inbound email PDF becomes a DRAFT Document plus a SignatureInboxItem that
// tracks the queue: received → OCR (BMS ML) → ready → sent for signature →
// completed. OCR-extracted data is stored for triage and to drive workflows
// (the INBOX_OCR_COMPLETED event fires once OCR finishes).
// ─────────────────────────────────────────────────────────────────────────────

enum InboxItemStatus {
  RECEIVED
  OCR_PROCESSING
  OCR_COMPLETED
  OCR_FAILED
  READY
  SENT_FOR_SIGNATURE
  COMPLETED
  ARCHIVED
}

model SignatureInboxItem {
  id             String          @id @default(cuid())
  organizationId Int
  documentId     Int             @unique
  status         InboxItemStatus @default(RECEIVED)

  senderEmail       String?
  subject           String?
  receivedById      Int? /// Org member (user id) the inbound doc was attributed to.
  externalMessageId String? /// Source message id (e.g. WorkHub email id) for idempotent polling.

  // OCR / BMS ML output.
  ocrProcessed  Boolean @default(false)
  ocrText       String? /// Raw OCR text (may be large).
  ocrConfidence Float?
  mlConfidence  Float?
  documentType  String?
  ocrEngine     String?
  needsReview   Boolean @default(false)
  extractedData Json? /// Flattened field_name → value map from BMS ML.
  ocrMeta       Json? /// Full OCR metadata (confidences, field_extractions, etc.).

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([createdAt])
  @@index([externalMessageId])
}
